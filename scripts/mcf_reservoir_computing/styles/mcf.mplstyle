# ====== БАЗОВОЕ ОФОРМЛЕНИЕ ======
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Helvetica
font.size: 11
mathtext.fontset: dejavusans

# Заголовки/подписи/тики
axes.titlesize: 12
axes.labelsize: 11
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

# ====== ЛИНИИ / ТИКИ / ОБВОДКИ ======
lines.linewidth: 1.35
lines.markersize: 5.2
axes.linewidth: 1.05
patch.linewidth: 1.0

xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True
xtick.major.size: 6
ytick.major.size: 6
xtick.major.width: 1.05
ytick.major.width: 1.05
xtick.minor.visible: False
ytick.minor.visible: False
xtick.minor.size: 3
ytick.minor.size: 3
xtick.minor.width: 0.8
ytick.minor.width: 0.8

axes.labelpad: 5
axes.titlepad: 7
xtick.major.pad: 3.5
ytick.major.pad: 3.5

axes.grid: False
grid.linewidth: 0.65
grid.linestyle: -
grid.alpha: 0.28

errorbar.capsize: 2.2

# Цвета: дружелюбная к дальтоникам палитра
axes.prop_cycle: cycler(color=["#006BA4", "#FF800E", "#ABABAB", "#595959", "#5F9ED1", "#C85200", "#898989", "#A2C8EC", "#FFBC79", "#CFCFCF"])

# ====== ЛЕГЕНДА ======
legend.frameon: True
legend.framealpha: 0.72
legend.fancybox: True
legend.loc: upper right
legend.handlelength: 2.0
legend.handletextpad: 0.8
legend.borderaxespad: 0.6
legend.columnspacing: 1.0
legend.facecolor: white
legend.edgecolor: black

# ====== ФИГУРЫ / ЭКСПОРТ ======
figure.dpi: 120
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.02
savefig.transparent: True
savefig.format: pdf

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

axes.formatter.use_mathtext: True

# ====== ИЗОБРАЖЕНИЯ / ТЕПЛОВЫЕ КАРТЫ ======
image.cmap: viridis

# ====== ПРОЧЕЕ ======
# constrained_layout лучше включать явно в коде для конкретных фигур.
