   "source": [
    "N, M = 10, 20\n",
    "id_matrix = Matrix{Int64}(undef, N, M)\n",
    "Threads.@threads for n in 1:N\n",
    "    for m in 1:M\n",
    "        id_matrix[n, m] = Threads.threadid()\n",
    "    end\n",
    "end\n",
    "\n",
    "println(id_matrix)"
